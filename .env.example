# ---- Server ----
PORT=10000
# Public URL of this service (no trailing slash). Render: https://mypos-checkout.onrender.com
APP_URL=https://mypos-checkout.onrender.com
# Where the SQLite database lives. On Render point this at the mounted disk.
DB_PATH=/var/data/mypos-checkout.sqlite

# ---- Admin page (/admin) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Shopify app (from the Shopify dev dashboard / Partners) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_orders,read_products
# App proxy subpath you configured in Shopify (prefix "apps", subpath "pay" => store.com/apps/pay)
PROXY_PREFIX=apps
PROXY_SUBPATH=pay

# ---- myPOS (one-time) ----
# EITHER paste the Configuration Pack string from your myPOS account ...
MYPOS_CONFIG_PACK=
# ... OR give the five values separately (they override the pack if set)
MYPOS_SID=
MYPOS_WALLET=
MYPOS_KEY_INDEX=1
# PEM blocks. On Render paste them as multi-line values, or replace newlines with \n
MYPOS_PRIVATE_KEY=
MYPOS_PUBLIC_CERT=
# 1 = use the myPOS sandbox (checkout-test), 0 = live
MYPOS_SANDBOX=1
# Language code shown on the myPOS payment page
MYPOS_LANG=EN
