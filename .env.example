# ---- Server ----
PORT=10000
# Public URL of this service (no trailing slash). Render: https://mypos-checkout.onrender.com
APP_URL=https://mypos-checkout.onrender.com
# Where the SQLite database lives. On Render point this at the mounted disk.
DB_PATH=/var/data/mypos-checkout.sqlite

# ---- Admin page (/admin) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Shopify app (from the Shopify dev dashboard / Partners) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_orders,read_products
# App proxy subpath you configured in Shopify (prefix "apps", subpath "pay" => store.com/apps/pay)
PROXY_PREFIX=apps
PROXY_SUBPATH=pay

# ---- myPOS (one-time) ----
# EITHER paste the Configuration Pack string from your myPOS account ...
MYPOS_CONFIG_PACK=
# ... OR give the five values separately (they override the pack if set)
MYPOS_SID=
MYPOS_WALLET=
MYPOS_KEY_INDEX=1
# PEM blocks. On Render paste them as multi-line values, or replace newlines with \n
MYPOS_PRIVATE_KEY=
MYPOS_PUBLIC_CERT=
# 1 = use the myPOS sandbox (checkout-test), 0 = live
MYPOS_SANDBOX=1
# Language code shown on the myPOS payment page
MYPOS_LANG=EN

# ---- PayPal module (served at /paypal; optional) ----
# Leave the two secrets empty and /paypal/* simply answers 503 — nothing else is affected.
PAYPAL_ENV=sandbox                 # sandbox | live (separate apps, separate ids)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # from PayPal dashboard after adding https://<host>/paypal/api/webhooks/paypal
PAYPAL_MONITOR_TOKEN=              # password for /paypal/monitor?token=...
PAYPAL_BRAND_NAME=Store            # shown on PayPal's page for /paypal/checkout
PAYPAL_CHARITY_NAME=               # exact charity name on the PayPal account; setting it enables /paypal/donate (category DONATION)
PAYPAL_DONATION_PRESETS=10,25,50
PAYPAL_DONATION_MIN=1
PAYPAL_DEFAULT_CURRENCY=GBP
PAYPAL_ORDER_WINDOW_HOURS=6        # 3 on older accounts; 24/48/72 if raised by PayPal
PAYPAL_DATA_DIR=/var/data          # orders + event log persist here (same disk as the sqlite db)
